# app.env.sample
# Copy to app.env and adjust values before starting the stack.
# These variables override the matching values in default.env for this app.
# No `export` prefix - this file is read by `docker compose --env-file`.

TZ=America/New_York
BASE_DOMAIN_NAME=example.com
BASE_HOST_NAME=hoarder.example.com

# NextAuth secret and Meilisearch master key (min 16 chars)
APP_SECRET_KEY=replace-with-a-random-32-byte-hex-string

# Optional: enable AI-powered tagging with an OpenAI-compatible provider
# OPENAI_API_KEY=replace-with-your-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
